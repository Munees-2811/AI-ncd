# ===== Backend =====
APP_NAME=NCD Shield AI
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ===== Database =====
POSTGRES_USER=ncd
POSTGRES_PASSWORD=ncd_password
POSTGRES_DB=ncd_shield
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Full URL (overrides individual vars if set). For local dev without Docker:
# DATABASE_URL=sqlite:///./ncd_shield.db
DATABASE_URL=postgresql+psycopg2://ncd:ncd_password@db:5432/ncd_shield

# ===== CORS =====
FRONTEND_ORIGIN=http://localhost:3000

# ===== Rate limiting =====
RATE_LIMIT=60/minute

# ===== Default admin (seeded on first run) =====
ADMIN_EMAIL=admin@ncdshield.ai
ADMIN_PASSWORD=Admin@12345

# ===== ML =====
MODEL_DIR=/app/ml/models

# ===== Health Assistant (optional) =====
# Set this to power the chatbot with Claude for natural, multilingual replies.
# If unset, the assistant uses its built-in rule-based responder (works offline).
# ANTHROPIC_API_KEY=sk-ant-...

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:8000
